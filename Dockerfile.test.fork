FROM maven:3.9-eclipse-temurin-21-noble

RUN apt-get update && apt-get install -y --no-install-recommends \
    unzip curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

ENV OPENJML_HOME=/opt/openjml
RUN mkdir -p "$OPENJML_HOME"

COPY --from=openjml-fork-build:latest /out/openjml.zip /tmp/openjml.zip

RUN unzip -q /tmp/openjml.zip -d "$OPENJML_HOME" \
    && if [ ! -f "$OPENJML_HOME/openjml" ]; then \
         INNER=$(find "$OPENJML_HOME" -maxdepth 1 -type d ! -path "$OPENJML_HOME" | head -1); \
         if [ -n "$INNER" ] && [ -f "$INNER/openjml" ]; then \
           mv "$INNER"/* "$OPENJML_HOME/" 2>/dev/null || true; \
           rmdir "$INNER" 2>/dev/null || true; \
         fi; \
       fi \
    && chmod +x "$OPENJML_HOME/openjml" "$OPENJML_HOME"/Solvers-linux/z3-* 2>/dev/null \
    && rm -f /tmp/openjml.zip

# cvc5 as an alternative to z3-4.7.1. Both support `define-fun-rec`; their
# heuristics differ, so offering both makes it possible to ask whichever one
# closes the proof first. Selected at runtime by the Inferrer via the
# OPENJML_PROVER environment variable (values: "z3" or "cvc5").
ARG CVC5_VERSION=1.2.0
RUN curl -sL -o /tmp/cvc5.zip \
       "https://github.com/cvc5/cvc5/releases/download/cvc5-${CVC5_VERSION}/cvc5-Linux-x86_64-static.zip" \
    && unzip -q /tmp/cvc5.zip -d /tmp/cvc5 \
    && CVC5_BIN=$(find /tmp/cvc5 -name cvc5 -type f -executable | head -1) \
    && if [ -n "$CVC5_BIN" ]; then cp "$CVC5_BIN" "$OPENJML_HOME/Solvers-linux/cvc5"; fi \
    && chmod +x "$OPENJML_HOME/Solvers-linux/cvc5" \
    && rm -rf /tmp/cvc5 /tmp/cvc5.zip

WORKDIR /app

# Build and install the jml-embedder sibling module first, so its 1.0.0-SNAPSHOT
# is available in the local Maven repository when the parent project's
# dependency resolution runs. The embedder has no transitive Maven Central
# misses; its only deps are ASM, SLF4J, and Gson.
COPY jml-embedder/ /tmp/jml-embedder/
RUN cd /tmp/jml-embedder && mvn -B install -DskipTests && rm -rf /tmp/jml-embedder

COPY pom.xml ./
RUN mvn dependency:go-offline -B

COPY src/ ./src/

CMD ["mvn", "test", "-B"]
