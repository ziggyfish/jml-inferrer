# =============================================================================
# OpenJML fork build environment
# =============================================================================
# Builds OpenJML from source with custom SMT-translator patches that add
# define-fun-rec based encodings for \sum, \num_of, \product. The final
# artifact is extracted as /out/openjml.zip.
#
# Usage:
#   docker build -f Dockerfile.build -t openjml-fork-build .
#   docker run --rm -v $(pwd)/out:/out openjml-fork-build
# =============================================================================

FROM ubuntu:22.04 AS build

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    git wget unzip curl ca-certificates \
    build-essential autoconf make \
    libxext-dev libxtst-dev libxrandr-dev libcups2-dev libasound2-dev \
    libxt-dev libfontconfig1-dev \
    zip file gawk python3 \
    && rm -rf /var/lib/apt/lists/*

# Boot JDK — OpenJML's build uses a prior Java to compile the OpenJDK module.
# 21 is current; we pick 20 as the boot JDK.
ENV BOOT_JDK_URL=https://download.java.net/java/GA/jdk20.0.2/6e380f22cbe7469fa75fb448bd903d8e/9/GPL/openjdk-20.0.2_linux-x64_bin.tar.gz

RUN mkdir -p /opt/boot-jdk \
    && wget -qO /tmp/boot-jdk.tgz "$BOOT_JDK_URL" \
    && tar -xzf /tmp/boot-jdk.tgz -C /opt/boot-jdk --strip-components=1 \
    && rm /tmp/boot-jdk.tgz \
    && /opt/boot-jdk/bin/java -version

ENV JAVA_HOME=/opt/boot-jdk
ENV PATH=$JAVA_HOME/bin:$PATH

WORKDIR /src

# Clone OpenJML and its sibling artifact repos. The `make release` step in the
# OpenJML Makefile expects JMLAnnotations, Specs, and Solvers as siblings of the
# OpenJML directory — it copies annotation sources into the build tree and bundles
# precompiled specs/solvers into the release zip.
RUN git clone https://github.com/OpenJML/OpenJML.git OpenJML \
    && git clone https://github.com/OpenJML/JMLAnnotations.git JMLAnnotations \
    && git clone --branch master-21 https://github.com/OpenJML/Specs.git Specs \
    && git clone https://github.com/OpenJML/Solvers.git Solvers \
    && git clone https://github.com/OpenJML/openjml.github.io.git openjml.github.io \
    && cd OpenJML && git log -1 --format='%H %ci' > /src/openjml-sha.txt

# Patches applied here before the build. The COPY happens at build time so
# edits to the patches force a rebuild of this layer only.
COPY patches/ /src/patches/

# Drop new files into their target packages.
RUN SMTLIB_DIR=/src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/smtlib/command \
    && ESC_DIR=/src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc \
    && if [ -f /src/patches/new-files/C_define_fun_rec.java ]; then \
         cp /src/patches/new-files/C_define_fun_rec.java "$SMTLIB_DIR/C_define_fun_rec.java"; \
         echo "Dropped C_define_fun_rec.java"; \
       fi \
    && if [ -f /src/patches/new-files/JmlBoundsExtractor.java ]; then \
         cp /src/patches/new-files/JmlBoundsExtractor.java "$ESC_DIR/JmlBoundsExtractor.java"; \
         echo "Dropped JmlBoundsExtractor.java"; \
       fi

# Drop z3-4.13.4 binary into Solvers/Solvers-linux/ so the release bundle picks
# it up alongside z3-4.7.1 / z3-4.3.x.  The 2026-04-29 z3 version-bump
# experiment found that z3-4.13.4 doesn't crack Recursive5.power either, but
# it does not regress any existing fixture and is more current upstream — so
# we ship both and let the user select via --exec or via --prover=z3_4_13.
RUN if [ -f /src/patches/binaries/z3-4.13.4 ]; then \
         cp /src/patches/binaries/z3-4.13.4 /src/Solvers/Solvers-linux/z3-4.13.4 \
         && chmod +x /src/Solvers/Solvers-linux/z3-4.13.4 \
         && echo "Dropped z3-4.13.4 into Solvers-linux"; \
       fi

# Drop z3-4.16.0 binary into Solvers/Solvers-linux/ alongside the older builds.
# The 2026-04-30 version-bump experiment ships z3-4.16.0 (latest stable as of
# Feb 2026) to test whether the residual SOLVER_UNKNOWN cases respond to the
# improved integer cuts (4.15.0), MBQI/quantifier-instantiation infrastructure
# (4.15.3), CAD/Hensel-lifting nonlinear arithmetic (4.15.5), and the
# nonchronological-backjumping UNKNOWN bug fix (4.15.5).  Selected at runtime
# via OpenJMLInvoker — the inferrer prefers z3-4.16.0 over z3-4.7.1 when both
# are present.  The prebuilt linux binary is built against glibc 2.39; if the
# test base image is older, that constraint will surface here.
RUN if [ -f /src/patches/binaries/z3-4.16.0 ]; then \
         cp /src/patches/binaries/z3-4.16.0 /src/Solvers/Solvers-linux/z3-4.16.0 \
         && chmod +x /src/Solvers/Solvers-linux/z3-4.16.0 \
         && echo "Dropped z3-4.16.0 into Solvers-linux"; \
       fi

# Apply the SMTTranslator patch via the Python script (python3 in base layer).
RUN if [ -f /src/patches/scripts/patch_smttranslator.py ]; then \
         python3 /src/patches/scripts/patch_smttranslator.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc/SMTTranslator.java; \
       fi

# Patch JmlSpecs.isEffectivelySpecPureMethod so that pure methods returning
# reference types (String.substring, Arrays.copyOf, etc.) qualify for the
# existing ESC determinism axiom. Without this, two calls to the same pure
# method (one in the body, one in the spec) become unrelated fresh result
# temps and the spec is unprovable. See patch_pure_determinism.py for
# the full rationale.
RUN if [ -f /src/patches/scripts/patch_pure_determinism.py ]; then \
         python3 /src/patches/scripts/patch_pure_determinism.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/JmlSpecs.java; \
       fi

# Fix the units of --timeout when passed to z3 (OpenJML treats it as seconds,
# z3's `-t:` is milliseconds). See patches/scripts/patch_z3_timeout.py for
# the full rationale. Without this, OpenJML's `--timeout=120` (intended as
# 2 minutes) becomes 120 ms to z3, which is far too short for the harder
# \sum / \product / \num_of obligations discharged by patch_smttranslator.py.
# We patch BOTH Solver_z3_4_3 (used by --prover=z3_4_3, the default) and
# Solver_z3_4_5 — they both have the same broken `-t:` invocation.
RUN if [ -f /src/patches/scripts/patch_z3_timeout.py ]; then \
         python3 /src/patches/scripts/patch_z3_timeout.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/smtlib/solvers/Solver_z3_4_3.java \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/smtlib/solvers/Solver_z3_4_5.java; \
       fi

# Suppress the "Validity is unknown - no model available" warning when the
# counterexample loop has ALREADY reported a valid Invalid assertion.  See
# patches/scripts/patch_methodprover_suppress_no_model_after_failure.py for
# the rationale.  Without this, time-budget-sensitive cases like
# PureCompoundWithLocals.distSquared report a real overflow obligation AND a
# secondary "Validity is unknown" message that incorrectly classifies the
# outcome as SOLVER_UNKNOWN.
RUN if [ -f /src/patches/scripts/patch_methodprover_suppress_no_model_after_failure.py ]; then \
         python3 /src/patches/scripts/patch_methodprover_suppress_no_model_after_failure.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc/MethodProverSMT.java; \
       fi

# Retry get_value(NULL) once when it fails with "model is not available".  See
# patches/scripts/patch_methodprover_retry_get_value.py for the rationale.
# Without this, time-budget-sensitive cases like PureCompoundWithLocals.distSquared
# emit a SOLVER_UNKNOWN warning even though z3 is fully capable of producing a
# model when re-asked.  The retry costs at most one extra check_sat per failed
# first-iteration case.
RUN if [ -f /src/patches/scripts/patch_methodprover_retry_get_value.py ]; then \
         python3 /src/patches/scripts/patch_methodprover_retry_get_value.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc/MethodProverSMT.java; \
       fi

# Treat dead z3 process (e.g. from -T: hard timeout) as TIMEOUT rather than
# internal ERROR.  See patches/scripts/patch_methodprover_dead_solver.py
# for the rationale.  Without this, Recursive5.power emits a hard ERROR
# after the new -T: cap fires; with the patch it correctly classifies as
# SOLVER_UNKNOWN/TIMEOUT.
RUN if [ -f /src/patches/scripts/patch_methodprover_dead_solver.py ]; then \
         python3 /src/patches/scripts/patch_methodprover_dead_solver.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc/MethodProverSMT.java; \
       fi

# Add z3 SMT options (macro-finder, qi.eager_threshold) to the start-of-script
# preamble so z3's quantifier engine has more headroom for axiomatic encodings.
# See patches/scripts/patch_z3_flags.py for the full rationale and the
# 2026-04-29 flag tuning campaign results.  Confirmed neutral on every
# fixture in our suite (PureCongruenceTest, ArrayCongruenceTest,
# PowerPrecondition, etc.); does not crack Recursive5.power but does not
# regress it either.
RUN if [ -f /src/patches/scripts/patch_z3_flags.py ]; then \
         python3 /src/patches/scripts/patch_z3_flags.py \
           /src/OpenJML/OpenJMLsrc/src/jdk.compiler/share/classes/org/jmlspecs/openjml/esc/SMTTranslator.java; \
       fi

# Patch the Specs/ tree (java/lang/String.jml + Integer.jml) so ESC mode sees
# useful postconditions for the most common String/Integer methods. Without
# this, half of the inferrers String-method tests can't discharge.
RUN if [ -f /src/patches/scripts/patch_string_jml.py ]; then \
         python3 /src/patches/scripts/patch_string_jml.py /src/Specs/specs; \
       fi

# Apply legacy git patches if any remain.
RUN if [ -d /src/patches ] && ls /src/patches/*.patch >/dev/null 2>&1; then \
      cd /src/OpenJML && for p in /src/patches/*.patch; do \
        echo "Applying $p"; \
        git apply --verbose "$p"; \
      done; \
    fi

# Build
WORKDIR /src/OpenJML/OpenJMLsrc

RUN bash ./configure \
      --with-boot-jdk=/opt/boot-jdk \
      --disable-warnings-as-errors \
      --build=x86_64-unknown-linux-gnu \
      --host=x86_64-unknown-linux-gnu \
      2>&1 | tail -30

RUN bash -c 'set -o pipefail; (make openjml 2>&1 | tail -200) && (make release 2>&1 | tail -50)'

# Final stage: just the zip
FROM alpine:3.19 AS artifact
RUN apk add --no-cache bash
COPY --from=build /src/OpenJML/OpenJMLsrc/release-temp/openjml*.zip /out/openjml.zip
COPY --from=build /src/openjml-sha.txt /out/openjml-sha.txt
CMD ["sh", "-c", "ls -la /out && echo 'Build complete'"]
