(set-info :status unsat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 5))
(assert (= (select arr 1) 13))
(assert (= (select arr 2) 2))
(assert (= (select arr 3) 18))
(assert (= (select arr 4) 18))
(assert (= (select arr 5) 15))
(assert (= (select arr 6) 14))
(assert (= (select arr 7) 6))
(assert (= (jsum arr 0 8) 92))
(check-sat)
