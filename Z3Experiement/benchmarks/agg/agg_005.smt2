(set-info :status unsat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jnum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (ite (> (select a lo) 0) 1 0) (jnum a (+ lo 1) hi))))
(assert (= (select arr 0) -1))
(assert (= (select arr 1) 2))
(assert (= (select arr 2) -3))
(assert (= (select arr 3) 4))
(assert (= (select arr 4) -8))
(assert (= (select arr 5) -4))
(assert (= (select arr 6) 8))
(assert (= (select arr 7) -4))
(assert (= (select arr 8) 8))
(assert (= (select arr 9) -9))
(assert (= (select arr 10) -9))
(assert (= (select arr 11) -7))
(assert (= (jnum arr 0 12) 5))
(check-sat)
