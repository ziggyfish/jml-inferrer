(set-info :status sat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 8))
(assert (= (select arr 1) 11))
(assert (= (select arr 2) 15))
(assert (= (select arr 3) 13))
(assert (= (select arr 4) 7))
(assert (= (select arr 5) 0))
(assert (= (select arr 6) 13))
(assert (= (select arr 7) 13))
(assert (= (select arr 8) 7))
(assert (= (select arr 9) 14))
(assert (= (select arr 10) 14))
(assert (= (jsum arr 0 11) 115))
(check-sat)
