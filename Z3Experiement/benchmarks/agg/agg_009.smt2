(set-info :status unsat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 12))
(assert (= (select arr 1) 5))
(assert (= (select arr 2) 16))
(assert (= (select arr 3) 12))
(assert (= (select arr 4) 15))
(assert (= (select arr 5) 13))
(assert (= (select arr 6) 6))
(assert (= (select arr 7) 13))
(assert (= (select arr 8) 1))
(assert (= (select arr 9) 6))
(assert (= (select arr 10) 7))
(assert (= (select arr 11) 3))
(assert (= (jsum arr 0 12) 110))
(check-sat)
