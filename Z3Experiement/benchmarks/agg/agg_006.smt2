(set-info :status sat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 5))
(assert (= (select arr 1) 12))
(assert (= (select arr 2) 13))
(assert (= (select arr 3) 14))
(assert (= (select arr 4) 6))
(assert (= (select arr 5) 1))
(assert (= (select arr 6) 7))
(assert (= (select arr 7) 17))
(assert (= (select arr 8) 3))
(assert (= (select arr 9) 12))
(assert (= (jsum arr 0 10) 90))
(check-sat)
