(set-info :status sat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jnum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (ite (> (select a lo) 0) 1 0) (jnum a (+ lo 1) hi))))
(assert (= (select arr 0) -9))
(assert (= (select arr 1) -8))
(assert (= (select arr 2) 1))
(assert (= (select arr 3) 8))
(assert (= (select arr 4) -4))
(assert (= (select arr 5) -10))
(assert (= (select arr 6) 2))
(assert (= (jnum arr 0 7) 3))
(check-sat)
