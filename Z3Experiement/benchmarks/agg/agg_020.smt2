(set-info :status sat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jnum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (ite (> (select a lo) 0) 1 0) (jnum a (+ lo 1) hi))))
(assert (= (select arr 0) -3))
(assert (= (select arr 1) 10))
(assert (= (select arr 2) 7))
(assert (= (select arr 3) -6))
(assert (= (select arr 4) 7))
(assert (= (select arr 5) -7))
(assert (= (select arr 6) 2))
(assert (= (select arr 7) -2))
(assert (= (select arr 8) 7))
(assert (= (select arr 9) -3))
(assert (= (jnum arr 0 10) 5))
(check-sat)
