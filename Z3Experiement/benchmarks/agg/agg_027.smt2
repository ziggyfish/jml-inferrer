(set-info :status unsat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 19))
(assert (= (select arr 1) 17))
(assert (= (select arr 2) 3))
(assert (= (select arr 3) 3))
(assert (= (select arr 4) 3))
(assert (= (select arr 5) 1))
(assert (= (select arr 6) 3))
(assert (= (select arr 7) 2))
(assert (= (select arr 8) 7))
(assert (= (select arr 9) 18))
(assert (= (select arr 10) 4))
(assert (= (jsum arr 0 11) 81))
(check-sat)
