(set-info :status sat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 17))
(assert (= (select arr 1) 1))
(assert (= (select arr 2) 19))
(assert (= (select arr 3) 3))
(assert (= (select arr 4) 17))
(assert (= (select arr 5) 8))
(assert (= (select arr 6) 16))
(assert (= (select arr 7) 4))
(assert (= (select arr 8) 16))
(assert (= (select arr 9) 1))
(assert (= (jsum arr 0 10) 102))
(check-sat)
