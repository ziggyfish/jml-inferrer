(set-info :status unsat)
(set-logic ALL)
(declare-const arr (Array Int Int))
(define-fun-rec jsum ((a (Array Int Int)) (lo Int) (hi Int)) Int
  (ite (>= lo hi) 0 (+ (select a lo) (jsum a (+ lo 1) hi))))
(assert (= (select arr 0) 11))
(assert (= (select arr 1) 16))
(assert (= (select arr 2) 15))
(assert (= (select arr 3) 19))
(assert (= (select arr 4) 8))
(assert (= (select arr 5) 14))
(assert (= (select arr 6) 9))
(assert (= (select arr 7) 12))
(assert (= (select arr 8) 12))
(assert (= (select arr 9) 2))
(assert (= (select arr 10) 3))
(assert (= (jsum arr 0 11) 122))
(check-sat)
